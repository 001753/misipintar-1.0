# ─────────────────────────────────────────────────────────────────────────────
# MISI PINTAR — Konfigurasi Environment
# Salin file ini ke .env lalu isi nilainya
# cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── DATABASE ──────────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL="postgresql://db_user:db_password@localhost:5432/db_misipintar"

# ── AUTH ──────────────────────────────────────────────────────────────────────
# URL publik aplikasi (tanpa trailing slash)
NEXTAUTH_URL="https://yourdomain.com"
NEXTAUTH_URL_INTERNAL="http://localhost:3000"

# Secret JWT — minimal 32 karakter acak
# Generate: openssl rand -base64 32
SESSION_SECRET="ganti_dengan_string_acak_minimal_32_karakter_xxxx"

# ── APP ───────────────────────────────────────────────────────────────────────
NODE_ENV="production"
APP_URL="https://yourdomain.com"
TRUST_PROXY="1"

# ── SEEDING SUPERADMIN (hapus setelah seeding) ────────────────────────────────
SEED_ADMIN_EMAIL="admin@yourdomain.com"
SEED_ADMIN_PASSWORD="GantiPasswordAman@123"

# ── MIDTRANS (Payment Gateway) ────────────────────────────────────────────────
# Dapatkan dari: https://dashboard.midtrans.com → Settings → Access Keys
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxxxxxxxxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxxxxxx"
MIDTRANS_IS_PRODUCTION="false"

# ── REDIS (Opsional — rate limiting & background jobs) ────────────────────────
# Jika tidak ada Redis, fitur rate-limit & notifikasi otomatis dinonaktifkan
# REDIS_URL="redis://localhost:6379"

# ── FIREBASE (Opsional — Push Notification FCM) ───────────────────────────────
# JSON service account dari Firebase Console → Project Settings → Service accounts
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# ── AWS S3 (Opsional — Upload foto bukti tugas) ───────────────────────────────
# AWS_ACCESS_KEY_ID="AKIAIOSFODNN7EXAMPLE"
# AWS_SECRET_ACCESS_KEY="wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
# AWS_REGION="ap-southeast-1"
# AWS_S3_BUCKET="misi-pintar-uploads"

# ── EMAIL / NODEMAILER (Opsional — notifikasi email) ─────────────────────────
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="noreply@yourdomain.com"
# SMTP_PASS="app_password_gmail"
# SMTP_FROM="Misi Pintar <noreply@yourdomain.com>"
