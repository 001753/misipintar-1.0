modules = ["nodejs-20", "web", "bash"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
build = ["bash", "-c", "npm run build"]
publicDir = "dist"
run = ["bash", "-c", "npm run start"]

[userenv]

[userenv.shared]
MIDTRANS_IS_PRODUCTION = "false"
TRUST_PROXY = "1"
NEXTAUTH_URL = "https://mp.jobenapp.cloud"
APP_URL = "https://mp.jobenapp.cloud"
NEXTAUTH_URL_INTERNAL = "http://localhost:5000"
