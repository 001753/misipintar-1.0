modules = ["nodejs-20", "web", "bash"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
build = ["bash", "-c", "npm run build:prod"]
run = ["bash", "-c", "npm run start"]

[userenv]

[userenv.shared]
MIDTRANS_IS_PRODUCTION = "false"
TRUST_PROXY = "1"
NEXTAUTH_URL = "https://8f0a9bc9-ea71-42cd-b831-f2da317277aa-00-252k5u34zr2f4.pike.replit.dev"
APP_URL = "https://8f0a9bc9-ea71-42cd-b831-f2da317277aa-00-252k5u34zr2f4.pike.replit.dev"
NEXTAUTH_URL_INTERNAL = "http://localhost:5000"
NODE_ENV = "development"
NEXTAUTH_TRUST_HOST = "1"
