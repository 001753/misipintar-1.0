# Force LF line endings for all text files — mencegah CRLF pada git checkout
# di server dengan core.autocrlf=true (cPanel, Windows, dll.)
* text=auto
# Shell scripts WAJIB LF — CRLF menyebabkan bash error "invalid option: pipefail"
*.sh        text eol=lf
*.bash      text eol=lf
# Node/config scripts
*.cjs       text eol=lf
*.mjs       text eol=lf
*.js        text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.json      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.env       text eol=lf
*.env.*     text eol=lf
# Binary — jangan disentuh
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.pdf binary
