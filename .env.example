# ─────────────────────────────────────────────────────────────────────────────
# MISI PINTAR — Konfigurasi Environment
# Salin file ini ke .env lalu isi nilainya:
#   cp .env.example .env && nano .env
#
# WAJIB diisi sebelum npm run build / deploy-cpanel.sh:
#   DATABASE_URL, NEXTAUTH_URL, SESSION_SECRET, APP_URL
#   NEXT_PUBLIC_FIREBASE_* (jika pakai push notification)
# ─────────────────────────────────────────────────────────────────────────────

# ── DATABASE ──────────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL="postgresql://db_user:db_password@localhost:5432/db_misipintar"

# ── AUTH ──────────────────────────────────────────────────────────────────────
# URL publik aplikasi (tanpa trailing slash)
NEXTAUTH_URL="https://yourdomain.com"
NEXTAUTH_URL_INTERNAL="http://localhost:3000"

# Secret JWT — minimal 32 karakter acak
# Generate: openssl rand -base64 32
SESSION_SECRET="ganti_dengan_string_acak_minimal_32_karakter_xxxx"

# ── APP ───────────────────────────────────────────────────────────────────────
NODE_ENV="production"
APP_URL="https://yourdomain.com"
TRUST_PROXY="1"

# IP yang diizinkan mengakses /superadmin (pisahkan koma, atau hilangkan untuk izinkan semua)
# Contoh: SUPERADMIN_ALLOWED_IPS="203.0.113.1,203.0.113.2"
# SUPERADMIN_ALLOWED_IPS="*"

# ── SEEDING SUPERADMIN (hapus setelah seeding pertama) ────────────────────────
SEED_ADMIN_EMAIL="admin@yourdomain.com"
SEED_ADMIN_PASSWORD="GantiPasswordAman@123"

# ── DOKU (Payment Gateway — invoice baru) ─────────────────────────────────────
# DOKU Checkout menerima Mandiri VA, kartu kredit, dan e-wallet.
# Jangan masukkan QRIS ke payment_method_types di source code.
DOKU_CLIENT_ID="MCH-xxxxxxxxxxxxxxxx"
DOKU_SECRET_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
DOKU_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
DOKU_PUBLIC_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
DOKU_IS_PRODUCTION="false"

# ── MIDTRANS (legacy — hanya menyelesaikan invoice lama) ──────────────────────
# Dapatkan dari: https://dashboard.midtrans.com → Settings → Access Keys
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxxxxxxxxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxxxxxx"
MIDTRANS_IS_PRODUCTION="false"

# ── REDIS (Opsional — rate limiting & background jobs) ────────────────────────
# Jika tidak ada Redis, rate-limit & BullMQ workers dinonaktifkan secara otomatis.
# Shared cPanel biasanya TIDAK menyediakan Redis — aman dikosongkan.
# REDIS_URL="redis://localhost:6379"

# ── FIREBASE SERVER (Opsional — Push Notification FCM via server) ─────────────
# Dapatkan dari: Firebase Console → Project Settings → Service accounts → Generate new private key
# Salin nilai dari JSON yang didownload ke 3 variabel berikut:
# FIREBASE_PROJECT_ID="your-project-id"
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ── FIREBASE CLIENT (WAJIB diisi SEBELUM BUILD jika pakai push notification) ───
# PENTING: Variabel NEXT_PUBLIC_* di-embed ke dalam JavaScript client saat `next build`.
#          Harus diisi di .env SEBELUM build agar push notification web berfungsi.
# Dapatkan dari: Firebase Console → Project Settings → General → Your apps → Web app → Config
# NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSy..."
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
# NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789"
# NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789:web:abc123"
# NEXT_PUBLIC_FIREBASE_VAPID_KEY="BNxxxxxxxx..."

# ── CLOUDFLARE R2 (Opsional — Upload foto bukti tugas & avatar) ───────────────
# Dapatkan dari: Cloudflare Dashboard → R2 → Manage R2 API Tokens
# R2_ACCOUNT_ID="your-cloudflare-account-id"
# R2_ACCESS_KEY_ID="your-r2-access-key-id"
# R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
# R2_BUCKET_NAME="misi-pintar-uploads"
# R2_PUBLIC_URL="https://cdn.yourdomain.com"

# ── EMAIL / NODEMAILER (Opsional — OTP & receipt via email) ───────────────────
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="noreply@yourdomain.com"
# SMTP_PASS="app_password_gmail_16_karakter"

# ── WHATSAPP / FONNTE (Opsional — OTP via WhatsApp) ──────────────────────────
# Dapatkan dari: https://md.fonnte.com → Devices → Token
# FONNTE_TOKEN="your-fonnte-api-token"
# QRIS_ADMIN_WA="081460081343"   # Nomor WhatsApp admin penerima notifikasi bukti QRIS

# ── SHARED HOSTING BUILD (cPanel) ─────────────────────────────────────────────
# Batasi thread Rust/SWC agar tidak panic di shared hosting (ulimit -u rendah)
RAYON_NUM_THREADS=1
