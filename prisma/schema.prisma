generator client {
  provider      = "prisma-client-js"
  engineType    = "binary"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────

enum Role {
  PARENT
  CHILD
  SUPER_ADMIN
}

enum PlanType {
  STARTER
  PRO
  EDUCATOR
  SCHOOL
}

enum SubStatus {
  TRIAL
  FREE
  PRO
  EDUCATOR
  SCHOOL
  EXPIRED
  CANCELLED
}

enum InvStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
  REFUNDED
}

enum PayMethod {
  QRIS
  GOPAY
  SHOPEEPAY
  BANK_TRANSFER
  CREDIT_CARD
  VA
}

enum TaskStatus {
  PENDING
  CLAIMED
  APPROVED
  REJECTED
}

enum TxType {
  TASK_REWARD
  SAVINGS_DEPOSIT
  SAVINGS_WITHDRAW
  CHARITY
  INTEREST
  TAX
  FINE
  ADJUSTMENT
}

enum PhaseMode {
  FULL_FREE
  FREEMIUM
  PAID_ONLY
}

enum OtpPurpose {
  RESET_PASSWORD
  VERIFY_PHONE
}

// ─── FAMILYSPACE (TENANT UTAMA) ──────────────────────────
model FamilySpace {
  id            String              @id @default(uuid())
  name          String
  spaceCode     String              @unique
  ownerId       String              @unique
  owner         User                @relation("FamilyOwner", fields: [ownerId], references: [id])
  users         User[]              @relation("FamilyMembers")
  children      Child[]
  tasks         Task[]
  ledger        TransactionLedger[]
  notifications Notification[]
  subscription  Subscription?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

// ─── USER (PARENT & SUPERADMIN) ──────────────────────────
model User {
  id            String          @id @default(uuid())
  phone         String?         @unique
  email         String?         @unique
  passwordHash  String
  name          String
  role          Role            @default(PARENT)
  familySpaceId String?
  familySpace   FamilySpace?    @relation("FamilyMembers", fields: [familySpaceId], references: [id])
  ownedSpace    FamilySpace?    @relation("FamilyOwner")
  fcmTokens     FcmToken[]
  notifications Notification[]
  auditLogs     AdminAuditLog[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([phone])
  @@index([email])
  @@index([familySpaceId, role])
}

// ─── OTP CODES ───────────────────────────────────────────
model OtpCode {
  id         String     @id @default(uuid())
  phone      String
  code       String
  purpose    OtpPurpose
  attempts   Int        @default(0)
  resetToken String?    @unique
  usedAt     DateTime?
  expiresAt  DateTime
  createdAt  DateTime   @default(now())

  @@index([phone, purpose])
  @@index([resetToken])
  @@index([expiresAt])
}

// ─── CHILD (AKUN ANAK) ───────────────────────────────────
model Child {
  id             String              @id @default(uuid())
  username       String
  passwordHash   String
  name           String
  avatar         String?
  familySpaceId  String
  familySpace    FamilySpace         @relation(fields: [familySpaceId], references: [id])
  balance        Int                 @default(0)
  savingsBalance Int                 @default(0)
  charityBalance Int                 @default(0)
  tasks          Task[]
  ledger         TransactionLedger[]
  fcmTokens      FcmToken[]
  deletedAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([familySpaceId, username])
  @@index([familySpaceId])
  @@index([familySpaceId, deletedAt])
}

// ─── TASK ────────────────────────────────────────────────
model Task {
  id             String      @id @default(uuid())
  familySpaceId  String
  familySpace    FamilySpace @relation(fields: [familySpaceId], references: [id])
  childId        String
  child          Child       @relation(fields: [childId], references: [id])
  title          String
  description    String?
  rewardAmount   Int
  status         TaskStatus  @default(PENDING)
  proofPhotoUrl  String?
  claimedAt      DateTime?
  approvedAt     DateTime?
  rejectedAt     DateTime?
  rejectedReason String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([familySpaceId, childId, status])
}

// ─── TRANSACTION LEDGER (IMMUTABLE) ──────────────────────
model TransactionLedger {
  id            String      @id @default(uuid())
  familySpaceId String
  familySpace   FamilySpace @relation(fields: [familySpaceId], references: [id])
  childId       String
  child         Child       @relation(fields: [childId], references: [id])
  type          TxType
  amount        Int
  balanceBefore Int
  balanceAfter  Int
  description   String
  refId         String?
  createdAt     DateTime    @default(now())

  @@index([familySpaceId, childId, createdAt(sort: Desc)])
}

// ─── PLAN ────────────────────────────────────────────────
model Plan {
  id            String         @id @default(uuid())
  type          PlanType       @unique
  name          String
  price         Int
  yearlyPrice   Int
  currency      String         @default("IDR")
  isActive      Boolean        @default(true)
  limits        Json
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
}

// ─── SUBSCRIPTION ────────────────────────────────────────
model Subscription {
  id                 String      @id @default(uuid())
  familySpaceId      String      @unique
  familySpace        FamilySpace @relation(fields: [familySpaceId], references: [id])
  planId             String
  plan               Plan        @relation(fields: [planId], references: [id])
  status             SubStatus   @default(FREE)
  invoiceId          String?     @unique
  trialEndsAt        DateTime?
  currentPeriodStart DateTime    @default(now())
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean     @default(false)
  cancelReason       String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  invoices           Invoice[]

  @@index([status, currentPeriodEnd])
}

// ─── INVOICE ─────────────────────────────────────────────
model Invoice {
  id              String       @id @default(uuid())
  subscriptionId  String
  subscription    Subscription @relation(fields: [subscriptionId], references: [id])
  amount          Int
  status          InvStatus    @default(PENDING)
  midtransOrderId String?      @unique
  snapToken       String?
  qrisQrUrl       String?
  qrisQrString    String?
  paymentMethod   PayMethod?
  paidAt          DateTime?
  expiredAt       DateTime
  createdAt       DateTime     @default(now())
  paymentLogs     PaymentLog[]

  @@index([subscriptionId])
  @@index([midtransOrderId])
  @@index([status, expiredAt])
}

// ─── PAYMENT LOG ─────────────────────────────────────────
model PaymentLog {
  id         String   @id @default(uuid())
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id])
  event      String
  rawPayload Json
  createdAt  DateTime @default(now())

  @@index([invoiceId])
}

// ─── NOTIFICATION ─────────────────────────────────────────
model Notification {
  id            String      @id @default(uuid())
  familySpaceId String
  familySpace   FamilySpace @relation(fields: [familySpaceId], references: [id])
  userId        String?
  user          User?       @relation(fields: [userId], references: [id])
  title         String
  body          String
  type          String
  isRead        Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@index([userId, isRead, createdAt(sort: Desc)])
}

// ─── FCM TOKEN ────────────────────────────────────────────
model FcmToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  childId   String?
  child     Child?   @relation(fields: [childId], references: [id])
  createdAt DateTime @default(now())
}

// ─── LOGIN ATTEMPT ────────────────────────────────────────
model LoginAttempt {
  id         String   @id @default(uuid())
  identifier String
  ipAddress  String
  success    Boolean
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt(sort: Desc)])
}

// ─── ADMIN AUDIT LOG ──────────────────────────────────────
model AdminAuditLog {
  id         String   @id @default(uuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id])
  action     String
  targetType String
  targetId   String
  before     Json?
  after      Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([targetType, targetId])
}

// ─── APP CONFIG ───────────────────────────────────────────
model AppConfig {
  id        String    @id @default("global-config")
  phaseMode PhaseMode @default(FULL_FREE)
  data      Json
  updatedAt DateTime  @updatedAt
}
